# macOS
.DS_Store

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checker / linter caches
.mypy_cache/
.ruff_cache/
.pyre/

# Build / packaging artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Jupyter
.ipynb_checkpoints/

# IDE/editor
.vscode/
.idea/

# Logs and temp files
*.log
*.tmp
*.swp

# Claude Code local settings (may contain API keys / personal config)
.claude/settings.local.json

# === Deliverable 2 ===
# Raw / processed BTC data — never commit. See data/README.md for download steps.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md
# Kaggle download landing folder (used during initial dataset acquisition).
kaggleData/

# Experiment results — large per-run files stay local; only summary + figures commit.
results/runs/
results/**/*.parquet
results/**/*.pickle
results/**/*.pkl
!results/README.md
!results/summary.csv
!results/figures/.gitkeep

# Notebook execution artefacts
notebooks/.ipynb_checkpoints/
